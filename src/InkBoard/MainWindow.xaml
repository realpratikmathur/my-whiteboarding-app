<Window
    x:Class="InkBoard.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:InkBoard"
    Title="InkBoard">

    <Grid x:Name="Root" RowDefinitions="Auto,Auto,*" ColumnDefinitions="Auto,*,Auto">
        <Grid.Resources>
            <local:CalligraphyPen x:Key="CalligraphyPen" />
            <local:PrivatePen x:Key="PrivatePen" />
        </Grid.Resources>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Z" Invoked="OnUndoInvoked" Modifiers="Control" />
            <KeyboardAccelerator Key="Y" Invoked="OnRedoInvoked" Modifiers="Control" />
            <KeyboardAccelerator Key="Delete" Invoked="OnDeleteInvoked" />
        </Grid.KeyboardAccelerators>

        <Grid Grid.ColumnSpan="3" ColumnDefinitions="Auto,*,Auto" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <StackPanel Margin="8,0" Orientation="Horizontal" Spacing="4">
                <ToggleButton
                    x:Name="PagesToggle"
                    AutomationProperties.Name="Pages"
                    IsChecked="True"
                    ToolTipService.ToolTip="Show or hide the page list">
                    <FontIcon FontSize="16" Glyph="&#xE700;" />
                </ToggleButton>
                <DropDownButton x:Name="FileButton" AutomationProperties.Name="File" Content="File">
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Click="OnOpenClick" Text="Import ink (.isf)…">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="O" Modifiers="Control" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Click="OnSaveClick" Text="Export ink (.isf)…">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="S" Modifiers="Control" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Click="OnExportPngClick" Text="Export PNG…" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="OnInsertImageClick" Text="Insert picture…" />
                            <MenuFlyoutItem Click="OnInsertPdfClick" Text="Insert PDF…" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="OnSaveObsLutClick" Text="Save OBS filter file (hides private notes)…" />
                            <MenuFlyoutItem Click="OnClearRecordingClick" Text="Clear this page&#39;s recording…" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="OnCutClick" Text="Cut selection">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="X" Modifiers="Control" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Click="OnCopyClick" Text="Copy selection">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="C" Modifiers="Control" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Click="OnPasteClick" Text="Paste">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="V" Modifiers="Control" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button
                    x:Name="UndoButton"
                    AutomationProperties.Name="Undo"
                    Click="OnUndoClick"
                    ToolTipService.ToolTip="Undo (Ctrl+Z)">
                    <FontIcon FontSize="16" Glyph="&#xE7A7;" />
                </Button>
                <Button
                    x:Name="RedoButton"
                    AutomationProperties.Name="Redo"
                    Click="OnRedoClick"
                    ToolTipService.ToolTip="Redo (Ctrl+Y)">
                    <FontIcon FontSize="16" Glyph="&#xE7A6;" />
                </Button>
                <TextBlock
                    x:Name="StatusText"
                    MaxWidth="240"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <InkToolbar
                x:Name="Toolbar"
                Grid.Column="1"
                HorizontalAlignment="Center"
                AutomationProperties.Name="Ink tools"
                InitialControls="None"
                TargetInkCanvas="{x:Bind InkSurface}">
                <InkToolbarBallpointPenButton x:Name="BallpointButton" />
                <InkToolbarPencilButton x:Name="PencilButton" />
                <InkToolbarHighlighterButton x:Name="HighlighterButton" />
                <InkToolbarCustomPenButton
                    x:Name="CalligraphyButton"
                    AutomationProperties.Name="Calligraphy pen"
                    CustomPen="{StaticResource CalligraphyPen}"
                    MaxStrokeWidth="24"
                    MinStrokeWidth="4"
                    SelectedStrokeWidth="10"
                    ToolTipService.ToolTip="Calligraphy pen">
                    <FontIcon Glyph="&#xEDFB;" />
                    <InkToolbarCustomPenButton.ConfigurationContent>
                        <InkToolbarPenConfigurationControl />
                    </InkToolbarCustomPenButton.ConfigurationContent>
                </InkToolbarCustomPenButton>
                <InkToolbarCustomPenButton
                    x:Name="PrivatePenButton"
                    AutomationProperties.Name="Private notes pen"
                    CustomPen="{StaticResource PrivatePen}"
                    MaxStrokeWidth="12"
                    MinStrokeWidth="2"
                    SelectedStrokeWidth="4"
                    ToolTipService.ToolTip="Private notes pen: removed from the video by the OBS colour key, never recorded or replayed">
                    <FontIcon Glyph="&#xE72E;" />
                    <InkToolbarCustomPenButton.ConfigurationContent>
                        <InkToolbarPenConfigurationControl />
                    </InkToolbarCustomPenButton.ConfigurationContent>
                </InkToolbarCustomPenButton>
                <InkToolbarEraserButton />
                <InkToolbarCustomToolButton
                    x:Name="PointEraserButton"
                    AutomationProperties.Name="Point eraser"
                    ToolTipService.ToolTip="Point eraser (erases part of a stroke)">
                    <FontIcon Glyph="&#xED60;" />
                </InkToolbarCustomToolButton>
                <InkToolbarCustomToolButton
                    x:Name="LassoButton"
                    AutomationProperties.Name="Lasso select"
                    ToolTipService.ToolTip="Lasso select (drag inside the selection to move, Delete to remove)">
                    <FontIcon Glyph="&#xEF20;" />
                </InkToolbarCustomToolButton>
                <InkToolbarCustomToolButton
                    x:Name="TextButton"
                    AutomationProperties.Name="Text and pictures"
                    ToolTipService.ToolTip="Text and pictures (tap to type; tap a text box or picture to select, drag to move)">
                    <FontIcon Glyph="&#xE8D2;" />
                </InkToolbarCustomToolButton>
                <InkToolbarStencilButton />
            </InkToolbar>

            <StackPanel
                Grid.Column="2"
                Margin="8,0"
                Orientation="Horizontal"
                Spacing="8">
                <ToggleButton
                    x:Name="RecordToggle"
                    AutomationProperties.Name="Record"
                    Checked="OnRecordToggled"
                    ToolTipService.ToolTip="Record what happens on this page; press again to stop"
                    Unchecked="OnRecordToggled">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="#FFE81123" />
                        <TextBlock x:Name="RecordLabel" Text="Record" />
                    </StackPanel>
                </ToggleButton>
                <Button x:Name="ReplayButton" AutomationProperties.Name="Replay" Click="OnReplayClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE768;" />
                        <TextBlock Text="Replay" />
                    </StackPanel>
                </Button>
                <DropDownButton x:Name="ConvertButton" AutomationProperties.Name="Convert selection" Content="Convert">
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Click="OnInkToTextClick" Text="Ink to text" />
                            <MenuFlyoutItem Click="OnInkToShapeClick" Text="Ink to shape" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <ToggleButton
                    x:Name="PrivateTextToggle"
                    AutomationProperties.Name="Private text"
                    Checked="OnPrivateTextChanged"
                    ToolTipService.ToolTip="New text boxes are private notes: removed from the video by the OBS colour key, never recorded or replayed"
                    Unchecked="OnPrivateTextChanged">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE72E;" />
                        <TextBlock Text="Private text" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton
                    x:Name="DrawWithTouchToggle"
                    Checked="OnDrawWithTouchChanged"
                    Content="Draw with touch"
                    Unchecked="OnDrawWithTouchChanged" />
                <Button
                    Click="OnResetZoomClick"
                    ToolTipService.ToolTip="Reset zoom to 100%">
                    <TextBlock x:Name="ZoomText" MinWidth="40" Text="100%" TextAlignment="Center" />
                </Button>
                <ToggleButton x:Name="DebugToggle" Content="Debug" />
            </StackPanel>
        </Grid>

        <!-- Replay transport, shown only while a recording is being played back. -->
        <Grid
            x:Name="ReplayBar"
            Grid.Row="1"
            Grid.ColumnSpan="3"
            Padding="8,4"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto"
            ColumnSpacing="8"
            Visibility="Collapsed">
            <Button x:Name="PlayPauseButton" AutomationProperties.Name="Play or pause" Click="OnPlayPauseClick">
                <FontIcon x:Name="PlayPauseIcon" FontSize="16" Glyph="&#xE768;" />
            </Button>
            <Button
                Grid.Column="1"
                AutomationProperties.Name="Restart"
                Click="OnRestartReplayClick"
                ToolTipService.ToolTip="Back to the start">
                <FontIcon FontSize="16" Glyph="&#xE892;" />
            </Button>
            <ComboBox
                x:Name="SpeedBox"
                Grid.Column="2"
                MinWidth="84"
                AutomationProperties.Name="Playback speed"
                SelectionChanged="OnSpeedChanged"
                ToolTipService.ToolTip="Playback speed" />
            <ProgressBar
                x:Name="ReplayProgress"
                Grid.Column="3"
                VerticalAlignment="Center" />
            <TextBlock
                x:Name="ReplayTime"
                Grid.Column="4"
                MinWidth="90"
                VerticalAlignment="Center"
                TextAlignment="Right" />
            <Button Grid.Column="5" Click="OnExitReplayClick" Content="Exit replay" />
        </Grid>

        <!-- Pages and subpages. -->
        <Grid
            x:Name="PagesPane"
            Grid.Row="2"
            Width="240"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            RowDefinitions="Auto,*"
            Visibility="{x:Bind PagesToggle.IsChecked, Mode=OneWay}">
            <StackPanel Margin="8,8,8,4" Orientation="Horizontal" Spacing="4">
                <Button Click="OnAddPageClick" ToolTipService.ToolTip="New page">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock Text="Page" />
                    </StackPanel>
                </Button>
                <Button Click="OnAddSubpageClick" ToolTipService.ToolTip="New subpage of the selected page">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock Text="Subpage" />
                    </StackPanel>
                </Button>
                <Button AutomationProperties.Name="Page options" ToolTipService.ToolTip="Rename, move or delete the selected page">
                    <FontIcon FontSize="14" Glyph="&#xE712;" />
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Click="OnRenamePageClick" Text="Rename…" />
                            <MenuFlyoutItem Click="OnMovePageUpClick" Text="Move up" />
                            <MenuFlyoutItem Click="OnMovePageDownClick" Text="Move down" />
                            <MenuFlyoutItem Click="OnDemotePageClick" Text="Make subpage" />
                            <MenuFlyoutItem Click="OnPromotePageClick" Text="Promote" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="OnDeletePageClick" Text="Delete…" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
            <TreeView
                x:Name="PageTree"
                Grid.Row="1"
                CanDragItems="False"
                CanReorderItems="False"
                ItemInvoked="OnPageInvoked"
                SelectionMode="Single" />
        </Grid>

        <!-- Touch pans and zooms; pen and mouse go to the InkCanvas. -->
        <ScrollViewer
            x:Name="CanvasScroller"
            Grid.Row="2"
            Grid.Column="1"
            Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
            HorizontalScrollBarVisibility="Auto"
            HorizontalScrollMode="Enabled"
            MaxZoomFactor="8"
            MinZoomFactor="0.25"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Enabled"
            ZoomMode="Enabled">
            <Grid x:Name="PageSurface" Width="4000" Height="3000" Background="White">
                <!-- Text boxes and pictures (pasted images, PDF pages). Ink is drawn above them. -->
                <Canvas x:Name="ObjectLayer" />

                <!-- Wet and dry ink are both rendered by the platform InkCanvas. The app draws no ink. -->
                <InkCanvas x:Name="InkSurface" AutomationProperties.Name="Whiteboard" />

                <!-- Selection chrome only (lasso outline and selection box). Never used for ink. -->
                <Canvas IsHitTestVisible="False">
                    <Polyline
                        x:Name="LassoLine"
                        Stroke="#FF0A64D8"
                        StrokeDashArray="4,3"
                        StrokeThickness="1.5"
                        Visibility="Collapsed" />
                    <Rectangle
                        x:Name="ObjectSelectionRect"
                        Stroke="#FF0A64D8"
                        StrokeThickness="1.5"
                        Visibility="Collapsed" />
                    <Rectangle
                        x:Name="ResizeHandle"
                        Width="18"
                        Height="18"
                        Fill="White"
                        Stroke="#FF0A64D8"
                        StrokeThickness="1.5"
                        Visibility="Collapsed" />
                    <Rectangle
                        x:Name="SelectionRect"
                        Stroke="#FF0A64D8"
                        StrokeDashArray="4,3"
                        StrokeThickness="1.5"
                        Visibility="Collapsed" />
                </Canvas>
            </Grid>
        </ScrollViewer>

        <!-- Beside the canvas, not over it: ink is composed as external content. -->
        <ScrollViewer
            Grid.Row="2"
            Grid.Column="2"
            Width="300"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            Visibility="{x:Bind DebugToggle.IsChecked, Mode=OneWay}">
            <StackPanel Padding="16" Spacing="12">
                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Ink modeler (A/B against OneNote)" />
                <Slider
                    x:Name="PredictionSlider"
                    Header="Prediction time (ms)"
                    Maximum="20"
                    Minimum="0"
                    StepFrequency="1"
                    ValueChanged="OnModelerSettingChanged" />
                <NumberBox
                    x:Name="ScalingBox"
                    Header="Scaling factor"
                    LargeChange="1"
                    Minimum="0.01"
                    SmallChange="0.1"
                    SpinButtonPlacementMode="Inline"
                    ValueChanged="OnScalingChanged" />
                <ToggleSwitch
                    x:Name="VelocityPressureSwitch"
                    Header="Velocity-based pressure"
                    Toggled="OnModelerSettingChanged" />
                <Button Click="OnResetModelerClick" Content="Reset to platform defaults" />
                <TextBlock
                    x:Name="ModelerStatus"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap" />

                <TextBlock
                    Margin="0,12,0,0"
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    Text="Diagnostics" />
                <TextBlock x:Name="ToolStatus" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock x:Name="HapticsStatus" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock x:Name="BarrelStatus" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
